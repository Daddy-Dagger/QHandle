{
  "name": "qhandle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run client\" \"npm run server\"",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "build": "npm run install:all && npm run build --prefix client",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
